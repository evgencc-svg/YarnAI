# Production database. PostgreSQL is required outside tests.
DATABASE_URL=postgresql+psycopg://yarnai:replace-me@localhost:5432/yarnai
# Optional separate database used only by automated tests.
TEST_DATABASE_URL=postgresql+psycopg://yarnai_test:replace-me@localhost:5432/yarnai_test

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-32-byte-secret
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_ISSUER=yarnai
AUTH_AUDIENCE=yarnai-web

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUSTED_PROXY_IPS=

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
MAX_REQUEST_BODY_BYTES=1048576
MAX_PROJECT_PAYLOAD_BYTES=524288
MAX_JSON_DEPTH=32
MAX_ACTIVE_SESSIONS=10
